# Terraform working directory: downloaded providers and modules
.terraform/

# State files: can contain secrets, and live in S3, never in git
*.tfstate
*.tfstate.*

# Saved plan files: binary, and may contain sensitive values
*.tfplan

# Crash logs
crash.log

# Lock files only belong in root modules, not reusable ones
modules/**/.terraform.lock.hcl

# Per-team Terraform data folders created by scripts/tf-team.sh
.terraform-*/